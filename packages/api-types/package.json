{
  "name": "@mabna/api-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint",
    "check-types": "tsc"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "pnpm --filter @mabna/api-types exec eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yaml,mjs}": "prettier --write"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
